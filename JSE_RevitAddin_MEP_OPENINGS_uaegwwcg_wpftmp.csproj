    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <!-- Launch configuration -->
