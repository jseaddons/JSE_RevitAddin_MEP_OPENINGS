          <mxGeometry x="800" y="800" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- ✅ CRITICAL: Check IsFilterComboNew Flag -->
        <mxCell id="checkComboFlag" value="Check FileCombos Table&#xa;IsFilterComboNew Flag&#xa;for this Filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="900" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- Query FileCombos -->
