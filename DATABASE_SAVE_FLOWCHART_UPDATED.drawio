<mxfile host="app.diagrams.net">
  <diagram name="Database Save Flowchart - With PATH Decision" id="database-save-flowchart-updated">
    <mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="2800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Start Node -->
        <mxCell id="start" value="User Clicks Refresh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#90EE90;strokeColor=#006400;" vertex="1" parent="1">
          <mxGeometry x="800" y="40" width="200" height="80" as="geometry" />
        </mxCell>
        
        <!-- OnRefreshClick -->
        <mxCell id="onRefresh" value="OnRefreshClick&#xa;EmergencyMainDialog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FF;strokeColor=#01579B;" vertex="1" parent="1">
          <mxGeometry x="800" y="160" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- RefreshService -->
