      ✅ MULTI-VERSION BUILD SYSTEM
      Defines the TargetFramework based on the selected configuration.
    -->
    <TargetFramework Condition="$(Configuration.Contains('R23'))">net48</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('R24'))">net48</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('R25'))">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('R26'))">net8.0-windows</TargetFramework>
    <!-- Default for Generic Restore (Batch Build) -->
    <TargetFrameworks Condition="'$(TargetFramework)' == ''">net48;net8.0-windows</TargetFrameworks>
    <Configurations>Debug;Release;Debug R23;Debug R24;Debug R25;Debug R26;Release R23;Release R24;Release R25;Release R26</Configurations>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x64'">AnyCPU</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <!-- Revit Version Property Mapping -->
  <PropertyGroup>
    <RevitVersion Condition="$(Configuration.Contains('R23'))">2023</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R24'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R25'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R26'))">2026</RevitVersion>
    <!-- Framework-aware defaults for generic restore (no R-config specified) -->
    <RevitVersion Condition="'$(RevitVersion)' == '' AND '$(TargetFramework)' == 'net48'">2024</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' AND '$(TargetFramework)' == 'net8.0-windows'">2025</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <DefineConstants Condition="'$(RevitVersion)' == '2023'">$(DefineConstants);REVIT2023</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2024'">$(DefineConstants);REVIT2024;REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2025'">$(DefineConstants);REVIT2025;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2026'">$(DefineConstants);REVIT2026;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
