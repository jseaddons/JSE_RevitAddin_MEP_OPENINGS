  <!-- 
    ✅ Post-Build logic - LOCAL DEPLOY ONLY
    Files are copied to a local deploy folder, NOT to ProgramData.
    Use deploy-to-revit.ps1 script to deploy when Revit is not running.
  -->
  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <LocalDeployFolder>$(MSBuildProjectDirectory)\deploy\$(RevitVersion)\</LocalDeployFolder>
      <LocalDeploySubfolder>$(LocalDeployFolder)JSE_MEP_OPENINGS\</LocalDeploySubfolder>
    </PropertyGroup>
    <MakeDir Directories="$(LocalDeployFolder)" />
    <MakeDir Directories="$(LocalDeploySubfolder)" />
    <!-- 1. Copy ALL DLLs and dependencies from OutputPath to JSE_MEP_OPENINGS subfolder -->
    <ItemGroup>
      <MainOutputFiles Include="$(OutputPath)*.dll" />
      <MainOutputFiles Include="$(OutputPath)*.pdb" />
      <MainOutputFiles Include="$(OutputPath)*.config" />
      <MainOutputFiles Include="$(OutputPath)*.json" Condition="'$(TargetFramework)' != 'net48'" />
      <!-- Native dependencies (Flattened for Revit) -->
      <NativeDlls Include="$(OutputPath)x64\SQLite.Interop.dll" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
      <NativeDlls Include="$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll" Condition="Exists('$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(MainOutputFiles)" DestinationFolder="$(LocalDeploySubfolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeDlls)" DestinationFolder="$(LocalDeploySubfolder)" SkipUnchangedFiles="true" />
    <!-- 2. Copy .addin and main DLL to root deploy folder -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(AssemblyName).addin" DestinationFolder="$(LocalDeployFolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(LocalDeployFolder)" SkipUnchangedFiles="true" />
    <!-- Legacy compatibility for x64 subfolder if needed -->
    <MakeDir Directories="$(LocalDeploySubfolder)x64\" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
    <Copy SourceFiles="$(OutputPath)x64\SQLite.Interop.dll" DestinationFolder="$(LocalDeploySubfolder)x64\" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
    <Message Text="✅ Build complete. Files consolidated in: $(LocalDeployFolder)" Importance="high" />
    <Message Text="⚠️  To deploy to Revit, close Revit and run: .\deploy-to-revit.ps1 -Version $(RevitVersion)" Importance="high" Condition="'$(DeployToRevit)' != 'true'" />
    <!-- Only deploy to ProgramData if explicitly requested AND Revit is not running -->
    <CallTarget Targets="DeployToRevitAddins" Condition="'$(DeployToRevit)' == 'true'" />
  </Target>
  <!-- 
    Separate target for deploying to Revit Addins folder.
    This is called manually via deploy-to-revit.ps1 or when DeployToRevit=true.
  -->
  <Target Name="DeployToRevitAddins">
    <PropertyGroup>
      <RevitAddinFolder>C:\ProgramData\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinFolder>
    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinFolder)" />
    <ItemGroup>
      <LocalApplicationFiles Include="$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.dll" Condition="Exists('$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.dll')" />
      <LocalApplicationFiles Include="$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.pdb" Condition="Exists('$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.pdb')" />
      <LocalSqliteDlls Include="$(LocalDeployFolder)System.Data.SQLite.dll" Condition="Exists('$(LocalDeployFolder)System.Data.SQLite.dll')" />
      <LocalSqliteDlls Include="$(LocalDeployFolder)e_sqlite3.dll" Condition="Exists('$(LocalDeployFolder)e_sqlite3.dll')" />
    </ItemGroup>
    <!-- Copy .addin to root addins folder -->
    <Copy SourceFiles="$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.addin" DestinationFolder="$(RevitAddinFolder)" ContinueOnError="true" />
    <!-- Copy DLLs to JSE_MEP_OPENINGS subfolder -->
    <MakeDir Directories="$(RevitAddinFolder)JSE_MEP_OPENINGS\" />
    <Copy SourceFiles="@(LocalApplicationFiles)" DestinationFolder="$(RevitAddinFolder)JSE_MEP_OPENINGS\" ContinueOnError="true" />
    <Copy SourceFiles="@(LocalSqliteDlls)" DestinationFolder="$(RevitAddinFolder)JSE_MEP_OPENINGS\" ContinueOnError="true" />
    <!-- Legacy compatibility for x64 subfolder -->
    <MakeDir Directories="$(RevitAddinFolder)JSE_MEP_OPENINGS\x64\" Condition="Exists('$(LocalDeployFolder)x64\SQLite.Interop.dll')" />
    <Copy SourceFiles="$(LocalDeployFolder)x64\SQLite.Interop.dll" DestinationFolder="$(RevitAddinFolder)JSE_MEP_OPENINGS\x64\" ContinueOnError="true" Condition="Exists('$(LocalDeployFolder)x64\SQLite.Interop.dll')" />
    <Message Text="✅ Deployed to Revit $(RevitVersion) Addins folder" Importance="high" />
  </Target>
