<!-- IMPORTANT: THERE IS NO HOST WALL, ONLY LINKED WALLS. ALL CODE AND LOGIC MUST ASSUME WALLS ARE LINKED. -->

<!-- WARNING: THIS PROJECT IS STRICTLY FOR REVIT 2023. -->
<!-- DO NOT CHANGE THE Nice3point.Revit.* PACKAGE VERSIONS BELOW. -->
<!-- If you change these versions, the add-in will NOT work and will cause runtime errors. -->
<!-- Only use the exact versions specified for Revit 2023 base installation. -->
<!-- If you need to upgrade to a different Revit version, consult the developer. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>true</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetFramework>net48</TargetFramework>
    <Configurations>Debug R21;Debug R22;Debug R23;Debug R24;Debug R25;Debug R26;Release R21;Release R22;Release R23;Release R24;Release R25;Release R26</Configurations>    <!-- Fixed version numbers -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <!-- Revit configuration -->
  <PropertyGroup Condition="$(Configuration.Contains('R21'))">
    <RevitVersion>2021</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R21'))">
    <DefineConstants>$(DefineConstants);REVIT2023_OR_LESS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R22'))">
    <RevitVersion>2022</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R22'))">
    <DefineConstants>$(DefineConstants);REVIT2023_OR_LESS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <DefineConstants>$(DefineConstants);REVIT2023_OR_LESS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <DefineConstants>$(DefineConstants);REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Launch configuration -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
    <StartArguments>/language ENG</StartArguments>
  </PropertyGroup>

  <!-- Build configuration -->
  <PropertyGroup>
    <IsRepackable>true</IsRepackable>
    <DeployRevitAddin>false</DeployRevitAddin>
    <BaseOutputPath>bin\$(Configuration)</BaseOutputPath>
    <Company>JSE</Company>
    <Description>OPENING PLACEMENT</Description>
  </PropertyGroup>
  
  <!-- ✅ Exclude native DLLs from ILRepack (native DLLs cannot be merged) -->
  <!-- ILRepack will fail if it tries to merge native DLLs like e_sqlite3.dll -->
  <!-- Native DLLs must remain as separate files and be copied alongside the merged DLL -->
  <!-- Nice3point.Revit.Build.Tasks uses RepackBinariesExcludes property to exclude files from ILRepack -->
  <PropertyGroup Condition="'$(IsRepackable)' == 'true'">
    <RepackBinariesExcludes>e_sqlite3.dll</RepackBinariesExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Commands\ApplyOpeningsFromCsvCommand.cs" />
    <Compile Remove="ViewModels\OpeningStatusPanelViewModel.cs" />
    <Compile Remove="ViewModels\OpeningStatusDialogViewModel.cs" />
    <Compile Remove="ViewModels\OpeningStatusItem.cs" />
    <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.0.1" />
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2023.1.0" />
    <PackageReference Include="Nice3point.Revit.Extensions" Version="2023.1.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2023.1.1" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2023.1.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="ILRepack" Version="2.0.41" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118.0" />
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="JSE_RevitAddin_MEP_OPENINGS.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ✅ Ensure SQLite native DLLs are copied to output directory for team deployment -->
  <ItemGroup>
    <!-- Managed provider assembly -->
    <None Include="$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\lib\net46\System.Data.SQLite.dll" Condition="Exists('$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\lib\net46\System.Data.SQLite.dll')">
      <Link>System.Data.SQLite.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ensure System.Data.SQLite native runtime (x64) is available in output -->
    <None Include="$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\runtimes\win-x64\native\SQLite.Interop.dll" Condition="Exists('$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\runtimes\win-x64\native\SQLite.Interop.dll')">
      <Link>x64\SQLite.Interop.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <RevitAddinFolder>C:\ProgramData\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinFolder>
    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinFolder)" />
    <!-- Copy main add-in DLL -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true" />
    <!-- Copy .addin manifest -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(AssemblyName).addin" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true" />
    <!-- ✅ Copy SQLite native DLLs for team deployment -->
    <ItemGroup>
      <SqliteDlls Include="$(OutputPath)System.Data.SQLite.dll" Condition="Exists('$(OutputPath)System.Data.SQLite.dll')" />
      <SqliteDlls Include="$(OutputPath)SQLite.Interop.dll" Condition="Exists('$(OutputPath)SQLite.Interop.dll')" />
    </ItemGroup>
    <Message Text="[PostBuild] Copying SQLite DLLs to $(RevitAddinFolder)" Importance="high" />
    <Message Text="[PostBuild] Found @(SqliteDlls->Count()) SQLite DLL(s) to copy" Importance="high" />
    <Copy SourceFiles="@(SqliteDlls)" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="CopiedSqliteDlls" />
    </Copy>
    <Message Text="[PostBuild] Copied @(CopiedSqliteDlls->Count()) SQLite DLL(s)" Importance="high" />
    <!-- Copy architecture-specific native runtime if present -->
    <ItemGroup>
      <SqliteInteropX64 Include="$(OutputPath)x64\SQLite.Interop.dll" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinFolder)x64\" Condition="@(SqliteInteropX64) != ''" />
    <Copy SourceFiles="@(SqliteInteropX64)" DestinationFolder="$(RevitAddinFolder)x64\" SkipUnchangedFiles="true" Condition="@(SqliteInteropX64) != ''" />
    <!-- Warn if critical native DLL is missing -->
    <Warning Text="[PostBuild] ⚠️ WARNING: SQLite.Interop.dll not found in build output! SQLite will not work. Check System.Data.SQLite package restore." Condition="!Exists('$(OutputPath)SQLite.Interop.dll') AND !Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
  </Target>

  <!-- Exclude backup files and reference files -->
  <!-- IMPORTANT: THERE IS NO HOST WALL, ONLY LINKED WALLS. DO NOT FILTER OR HANDLE HOST WALLS. -->
  <ItemGroup>
    <Compile Remove="Services\*BKP*.cs" />
    <Compile Remove="Commands\*BKP*.cs" />
    <Compile Remove="Services\Archive\**\*.cs" />
    <Compile Remove="Archive\**\*.cs" />
    <!-- ✅ ENABLED: refresh refactor files are now included for compilation -->
    <!-- <Compile Remove="refresh refactor\**\*.cs" /> -->
    <Compile Remove="Commands\Backup\**\*.cs" />
    <Compile Remove="Views\Backup\**\*.cs" />
    <Compile Remove="ViewModels\Backup\**\*.cs" />
    <Compile Remove="Helpers\Backup\**\*.cs" />
    <Page Remove="Views\Backup\**\*.xaml" />
    <Compile Remove="Services\Backup\**\*.cs" />
    <Compile Remove="Services\Backup2\**\*.cs" />
    <!-- ✅ PHASE 2: Legacy RefreshService excluded - only refactored service is used -->
    <Compile Remove="Services\RefreshService.cs" />
    <Compile Remove="Commands\ClusterMergeCommand.cs" />
    <Compile Remove="Commands\CleanCableTraySleevesCommand.cs" />
    <Compile Remove="Commands\IndividualDuctSleeveCommand.cs" />
    <Compile Remove="Services\Archive\ClusterMergeCommand.cs" />
    <Compile Remove="Services\Archive\ClusterFamilyData.cs" />
    <Compile Remove="Services\Archive\CompareDuctCableTrayPlacementCommand.cs" />
    <Compile Remove="ViewModels\ClusterMergeToolViewModel.cs" />
    <Compile Remove="Services\Backup\*BKP*.cs" />
    <Compile Remove="Commands\Backup\*BKP*.cs" />
    <Compile Remove="*BKP*.cs" />
    <Compile Remove="*Backup*.cs" />
    <Compile Remove="Backup\*.cs" />
    <Compile Remove="Reference\**" />
    <None Remove="BACKUP_WORKING_2025-06-26_16-30-47_CableTrayFixed\**" />
    <None Remove="Reference\**" />
    <Content Remove="BACKUP_WORKING_2025-06-26_16-30-47_CableTrayFixed\**" />
    <Content Remove="Reference\**" />
    <EmbeddedResource Remove="BACKUP_WORKING_2025-06-26_16-30-47_CableTrayFixed\**" />
    <EmbeddedResource Remove="Reference\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\RibbonIcon16.png" />
    <Resource Include="Resources\Icons\RibbonIcon32.png" />
  </ItemGroup>

</Project>