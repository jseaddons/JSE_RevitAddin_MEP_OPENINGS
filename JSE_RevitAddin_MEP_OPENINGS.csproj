<!-- IMPORTANT: THERE IS NO HOST WALL, ONLY LINKED WALLS. ALL CODE AND LOGIC MUST ASSUME WALLS ARE LINKED. -->

<!-- ✅ UPDATED: NOW BUILDS FOR REVIT 2023, 2024, 2025, AND 2026 -->
<!-- Each version uses its correct .NET framework: -->
<!-- - Revit 2023: .NET Framework 4.8 -->
<!-- - Revit 2024: .NET 6.0 -->
<!-- - Revit 2025: .NET 8.0 -->
<!-- - Revit 2026: .NET 8.0 -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>true</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Configurations>Debug R23;Debug R24;Debug R25;Debug R26;Release R23;Release R24;Release R25;Release R26</Configurations>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>false</Deterministic>
    <!-- Ensure lock file assemblies are copied (was incorrectly placed in ItemGroup causing MSB4232) -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Resolve TaskDialog ambiguity between WinForms and Revit API in .NET 6+ -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Using Include="Autodesk.Revit.UI.TaskDialog" Alias="TaskDialog" />
    <Using Include="Autodesk.Revit.UI.TaskDialogResult" Alias="TaskDialogResult" />
    <Using Include="Autodesk.Revit.UI.TaskDialogCommonButtons" Alias="TaskDialogCommonButtons" />
    <Using Include="Autodesk.Revit.UI.TaskDialogIcon" Alias="TaskDialogIcon" />
  </ItemGroup>

  <!-- Revit 2023 configuration - .NET Framework 4.8 -->
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2024 configuration - .NET 6.0 -->
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net6.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2024</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2025 configuration - .NET 8.0 -->
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <!-- Revit 2026 configuration - .NET 8.0 -->
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2026</DefineConstants>
  </PropertyGroup>

  <!-- Launch configuration -->
  <PropertyGroup>
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
    <StartArguments>/language ENG</StartArguments>
  </PropertyGroup>

  <!-- Build configuration -->
  <PropertyGroup>
    <IsRepackable>true</IsRepackable>
    <DeployRevitAddin>false</DeployRevitAddin>
    <BaseOutputPath>bin\$(Configuration)</BaseOutputPath>
    <Company>JSE</Company>
    <Description>OPENING PLACEMENT</Description>
  </PropertyGroup>
  
  <!-- ✅ Exclude native DLLs from ILRepack (native DLLs cannot be merged) -->
  <!-- ILRepack will fail if it tries to merge native DLLs like e_sqlite3.dll -->
  <!-- Native DLLs must remain as separate files and be copied alongside the merged DLL -->
  <!-- Nice3point.Revit.Build.Tasks uses RepackBinariesExcludes property to exclude files from ILRepack -->
  <PropertyGroup Condition="'$(IsRepackable)' == 'true'">
    <!-- Exclude SQLite managed and native binaries so they are not merged and remain deployable -->
    <RepackBinariesExcludes>System.Data.SQLite.dll;SQLite.Interop.dll;e_sqlite3.dll</RepackBinariesExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- ✅ OOP REFACTORING: Exclude backup folders from compilation to avoid duplicate class errors -->
    <Compile Remove="_BACKUPS\**" />
    <Compile Remove="_BACKUPS/**" />
    <EmbeddedResource Remove="_BACKUPS\**" />
    <None Remove="_BACKUPS\**" />
    <!-- Additional strict removal patterns to suppress lingering backup code from build -->
    <Compile Remove="_BACKUPS/**/*.cs" />
    <Compile Remove="_BACKUPS/**/**/*.cs" />
    <Compile Remove="Services/Backup/**/*.cs" />
    <Compile Remove="Services/Backup2/**/*.cs" />
    <Compile Remove="Services\\Backup\\**\\*.cs" />
    <Compile Remove="Services\\Backup2\\**\\*.cs" />
    <Compile Remove="**/_BACKUPS/**" />
    <Compile Remove="**/_BACKUPS/**/*.cs" />
    <Compile Remove="**/Services_Full/**" />
    <Compile Remove="**/Services_Full/**/*.cs" />
    <Compile Remove="**/Archive/**" />
    
    <Compile Remove="Commands\ApplyOpeningsFromCsvCommand.cs" />
    <Compile Remove="ViewModels\OpeningStatusPanelViewModel.cs" />
    <Compile Remove="ViewModels\OpeningStatusDialogViewModel.cs" />
    <Compile Remove="ViewModels\OpeningStatusItem.cs" />
    <!-- ✅ Temporarily exclude from build - being worked on by another agent -->
    <Compile Remove="Services\SleevePlacementCoordinator.cs" />
    <!-- ✅ ENABLED: NewSleevePlacerService is now ready for use with feature flag -->
    <!-- <Compile Remove="Services\NewSleevePlacerService.cs" /> -->
  </ItemGroup>

  <!-- NuGet packages for all versions -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.*" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="ILRepack" Version="2.0.41" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118.0" />
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
  </ItemGroup>

  <!-- Revit-specific packages for each version -->
  <ItemGroup Condition="$(Configuration.Contains('R23'))">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2023.*" />
    <PackageReference Include="Nice3point.Revit.Extensions" Version="2023.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2023.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2023.*" />
  </ItemGroup>

  <ItemGroup Condition="$(Configuration.Contains('R24'))">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2024.*" />
    <PackageReference Include="Nice3point.Revit.Extensions" Version="2024.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.*" />
  </ItemGroup>

  <ItemGroup Condition="$(Configuration.Contains('R25'))">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2025.*" />
    <PackageReference Include="Nice3point.Revit.Extensions" Version="2025.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" />
  </ItemGroup>

  <ItemGroup Condition="$(Configuration.Contains('R26'))">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Extensions" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="JSE_RevitAddin_MEP_OPENINGS.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ✅ Ensure SQLite native DLLs are copied to output directory for team deployment -->
  <ItemGroup>
    <!-- Managed provider assembly -->
    <None Include="$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\lib\net46\System.Data.SQLite.dll" Condition="Exists('$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\lib\net46\System.Data.SQLite.dll')">
      <Link>System.Data.SQLite.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ensure System.Data.SQLite native runtime (x64) is available in output -->
    <None Include="$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\runtimes\win-x64\native\SQLite.Interop.dll" Condition="Exists('$(NuGetPackageRoot)system.data.sqlite.core\1.0.118.0\runtimes\win-x64\native\SQLite.Interop.dll')">
      <Link>x64\SQLite.Interop.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <RevitAddinFolder>C:\ProgramData\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinFolder>
    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinFolder)" />
    <!-- Copy main add-in DLL -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true" />
    <!-- Copy .addin manifest -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(AssemblyName).addin" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true" />
    <!-- ✅ Copy SQLite native DLLs for team deployment -->
    <ItemGroup>
      <SqliteDlls Include="$(OutputPath)System.Data.SQLite.dll" Condition="Exists('$(OutputPath)System.Data.SQLite.dll')" />
      <!-- Native may be under x64 folder only -->
      <SqliteDlls Include="$(OutputPath)SQLite.Interop.dll" Condition="Exists('$(OutputPath)SQLite.Interop.dll')" />
      <SqliteDlls Include="$(OutputPath)x64\SQLite.Interop.dll" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
    </ItemGroup>
    <Message Text="[PostBuild] Copying SQLite DLLs to $(RevitAddinFolder)" Importance="high" />
    <Message Text="[PostBuild] Found @(SqliteDlls->Count()) SQLite DLL(s) to copy" Importance="high" />
    <Copy SourceFiles="@(SqliteDlls)" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="CopiedSqliteDlls" />
    </Copy>
    <Message Text="[PostBuild] Copied @(CopiedSqliteDlls->Count()) SQLite DLL(s)" Importance="high" />
    <!-- Copy architecture-specific native runtime if present -->
    <ItemGroup>
      <SqliteInteropX64 Include="$(OutputPath)x64\SQLite.Interop.dll" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
    </ItemGroup>
    <MakeDir Directories="$(RevitAddinFolder)x64\" Condition="@(SqliteInteropX64) != ''" />
    <Copy SourceFiles="@(SqliteInteropX64)" DestinationFolder="$(RevitAddinFolder)x64\" SkipUnchangedFiles="true" Condition="@(SqliteInteropX64) != ''" />
    <!-- Warn if critical native DLL is missing -->
    <Warning Text="[PostBuild] ⚠️ WARNING: SQLite.Interop.dll not found in build output (neither root nor x64). SQLite will not work. Check System.Data.SQLite package restore." Condition="!Exists('$(OutputPath)SQLite.Interop.dll') AND !Exists('$(OutputPath)x64\SQLite.Interop.dll')" />

    <!-- Verification marker removed (MSB4012) to avoid item list concatenation error -->
  </Target>

  <!-- Exclude backup files and reference files -->
  <!-- IMPORTANT: THERE IS NO HOST WALL, ONLY LINKED WALLS. DO NOT FILTER OR HANDLE HOST WALLS. -->
  <ItemGroup>
    <Compile Remove="Services\*BKP*.cs" />
    <Compile Remove="Commands\*BKP*.cs" />
    <Compile Remove="Services\Archive\**\*.cs" />
    <Compile Remove="Archive\**\*.cs" />
    <!-- ✅ ENABLED: refresh refactor files are now included for compilation -->
    <!-- <Compile Remove="refresh refactor\**\*.cs" /> -->
    <Compile Remove="Commands\Backup\**\*.cs" />
    <Compile Remove="Views\Backup\**\*.cs" />
    <Compile Remove="ViewModels\Backup\**\*.cs" />
    <Compile Remove="Helpers\Backup\**\*.cs" />
    <Page Remove="Views\Backup\**\*.xaml" />
    <Compile Remove="Services\Backup\**\*.cs" />
    <Compile Remove="Services\Backup2\**\*.cs" />
    <!-- ✅ PHASE 2: Legacy RefreshService excluded - only refactored service is used -->
    <!-- ✅ DEPRECATED: FireDamperSleevePlacerService moved to backup - no longer used -->
    <Compile Remove="Services\FireDamperSleevePlacerService.cs" />
    <Compile Remove="Commands\ClusterMergeCommand.cs" />
    <Compile Remove="Commands\CleanCableTraySleevesCommand.cs" />
    <Compile Remove="Commands\IndividualDuctSleeveCommand.cs" />
    <Compile Remove="Services\Archive\ClusterMergeCommand.cs" />
    <Compile Remove="Services\Archive\ClusterFamilyData.cs" />
    <Compile Remove="Services\Archive\CompareDuctCableTrayPlacementCommand.cs" />
    <Compile Remove="ViewModels\ClusterMergeToolViewModel.cs" />
    <Compile Remove="Services\Backup\*BKP*.cs" />
    <Compile Remove="Commands\Backup\*BKP*.cs" />
    <Compile Remove="*BKP*.cs" />
    <Compile Remove="*Backup*.cs" />
    <Compile Remove="Backup\*.cs" />
    <Compile Remove="Reference\**" />
    <None Remove="BACKUP_WORKING_2025-06-26_16-30-47_CableTrayFixed\**" />
    <None Remove="Reference\**" />
    <None Remove="Docs\**" />
    <Content Remove="BACKUP_WORKING_2025-06-26_16-30-47_CableTrayFixed\**" />
    <Content Remove="Reference\**" />
    <Content Remove="Docs\**" />
    <EmbeddedResource Remove="BACKUP_WORKING_2025-06-26_16-30-47_CableTrayFixed\**" />
    <EmbeddedResource Remove="Reference\**" />
    <EmbeddedResource Remove="Docs\**" />
    <Compile Remove="Docs\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\RibbonIcon16.png" />
    <Resource Include="Resources\Icons\RibbonIcon32.png" />
  </ItemGroup>

  <!-- Exclude backup folder from compilation -->
  <ItemGroup>
    <Compile Remove="_BACKUPS/**/*.cs" />
  </ItemGroup>

</Project>
