<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 
      ✅ MULTI-VERSION BUILD SYSTEM
      Defines the TargetFramework based on the selected configuration.
    -->
    <TargetFramework Condition="$(Configuration.Contains('R23'))">net48</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('R24'))">net48</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('R25'))">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(Configuration.Contains('R26'))">net8.0-windows</TargetFramework>
    
    <!-- Default for Generic Restore (Batch Build) -->
    <TargetFrameworks Condition="'$(TargetFramework)' == ''">net48;net8.0-windows</TargetFrameworks>

    <Configurations>Debug;Release;Debug R23;Debug R24;Debug R25;Debug R26;Release R23;Release R24;Release R25;Release R26</Configurations>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x64'">AnyCPU</PlatformTarget>

    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Revit Version Property Mapping -->
  <PropertyGroup>
    <RevitVersion Condition="$(Configuration.Contains('R23'))">2023</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R24'))">2024</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R25'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R26'))">2026</RevitVersion>
    <!-- Framework-aware defaults for generic restore (no R-config specified) -->
    <RevitVersion Condition="'$(RevitVersion)' == '' AND '$(TargetFramework)' == 'net48'">2024</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' AND '$(TargetFramework)' == 'net8.0-windows'">2025</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    
    <DefineConstants Condition="'$(RevitVersion)' == '2023'">$(DefineConstants);REVIT2023</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2024'">$(DefineConstants);REVIT2024;REVIT2024_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2025'">$(DefineConstants);REVIT2025;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2026'">$(DefineConstants);REVIT2026;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- TaskDialog ambiguity fix -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48' AND '$(TargetFramework)' != ''">
    <Using Include="Autodesk.Revit.UI.TaskDialog" Alias="TaskDialog" />
    <Using Include="Autodesk.Revit.UI.TaskDialogResult" Alias="TaskDialogResult" />
    <Using Include="Autodesk.Revit.UI.TaskDialogCommonButtons" Alias="TaskDialogCommonButtons" />
    <Using Include="Autodesk.Revit.UI.TaskDialogIcon" Alias="TaskDialogIcon" />
  </ItemGroup>

  <PropertyGroup>
    <IsRepackable>true</IsRepackable>
    <BaseOutputPath>bin\</BaseOutputPath>
    <Company>JSE</Company>
    <Description>OPENING PLACEMENT</Description>
    <RepackBinariesExcludes>System.Data.SQLite.dll;SQLite.Interop.dll;e_sqlite3.dll;Microsoft.Data.Sqlite.dll;SQLitePCLRaw.batteries_v2.dll;SQLitePCLRaw.core.dll;SQLitePCLRaw.provider.e_sqlite3.dll;SQLitePCLRaw.bundle_e_sqlite3.dll;Serilog.dll;Serilog.Sinks.Debug.dll;CommunityToolkit.Mvvm.dll;Nice3point.Revit.Toolkit.dll;Nice3point.Revit.Extensions.dll;Newtonsoft.Json.dll;System.Text.Json.dll</RepackBinariesExcludes>
  </PropertyGroup>

  <!-- Global NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.*" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="ILRepack" Version="2.0.41" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Text.Json" Version="6.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Framework-specific SQLite -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!-- Revit API Packages per version -->
  <ItemGroup Condition="'$(RevitVersion)' == '2023'">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2023.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2023.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2023.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2024'">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2024.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2025.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.*" />
  </ItemGroup>

  <!-- Build Exclusions -->
  <ItemGroup>
    <Compile Remove="_BACKUPS\**" />
    <Compile Remove="**/_BACKUPS/**" />
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
    <Compile Remove="Docs\**" />
    <Compile Remove="**/Docs/**" />
    <Compile Remove="BACKUP\**" />
    <Compile Remove="**/BACKUP/**" />
    <Compile Remove="Backup\**" />
    <Compile Remove="**/Backup/**" />
    <Compile Remove="Backup2\**" />
    <Compile Remove="**/Backup2/**" />
    <Compile Remove="**/Services_Full/**" />
    <Compile Remove="**/Archive/**" />
    <Compile Remove="**/New folder/**" />
    <Compile Remove="Services\SleevePlacementCoordinator.cs" />
    <Compile Remove="**/*.backup_*" />
    <Compile Remove="**/*.bak" />
    <Compile Remove="**/*.tmp" />
  </ItemGroup>

  <!-- 
    ✅ Post-Build logic - LOCAL DEPLOY ONLY
    Files are copied to a local deploy folder, NOT to ProgramData.
    Use deploy-to-revit.ps1 script to deploy when Revit is not running.
  -->
  <Target Name="PostBuild" AfterTargets="Build">
    <PropertyGroup>
      <LocalDeployFolder>$(MSBuildProjectDirectory)\deploy\$(RevitVersion)\</LocalDeployFolder>
      <LocalDeploySubfolder>$(LocalDeployFolder)JSE_MEP_OPENINGS\</LocalDeploySubfolder>
    </PropertyGroup>
    
    <MakeDir Directories="$(LocalDeployFolder)" />
    <MakeDir Directories="$(LocalDeploySubfolder)" />
    
    <!-- 1. Copy ALL DLLs and dependencies from OutputPath to JSE_MEP_OPENINGS subfolder -->
    <ItemGroup>
      <MainOutputFiles Include="$(OutputPath)*.dll" />
      <MainOutputFiles Include="$(OutputPath)*.pdb" />
      <MainOutputFiles Include="$(OutputPath)*.config" />
      <MainOutputFiles Include="$(OutputPath)*.json" Condition="'$(TargetFramework)' != 'net48'" />
      
      <!-- Native dependencies (Flattened for Revit) -->
      <NativeDlls Include="$(OutputPath)x64\SQLite.Interop.dll" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
      <NativeDlls Include="$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll" Condition="Exists('$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll')" />
    </ItemGroup>
    
    <Copy SourceFiles="@(MainOutputFiles)" DestinationFolder="$(LocalDeploySubfolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeDlls)" DestinationFolder="$(LocalDeploySubfolder)" SkipUnchangedFiles="true" />
    
    <!-- 2. Copy .addin and main DLL to root deploy folder -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(AssemblyName).addin" DestinationFolder="$(LocalDeployFolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(LocalDeployFolder)" SkipUnchangedFiles="true" />
    
    <!-- Legacy compatibility for x64 subfolder if needed -->
    <MakeDir Directories="$(LocalDeploySubfolder)x64\" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />
    <Copy SourceFiles="$(OutputPath)x64\SQLite.Interop.dll" DestinationFolder="$(LocalDeploySubfolder)x64\" SkipUnchangedFiles="true" Condition="Exists('$(OutputPath)x64\SQLite.Interop.dll')" />

    <Message Text="✅ Build complete. Files consolidated in: $(LocalDeployFolder)" Importance="high" />
    <Message Text="⚠️  To deploy to Revit, close Revit and run: .\deploy-to-revit.ps1 -Version $(RevitVersion)" Importance="high" Condition="'$(DeployToRevit)' != 'true'" />
    
    <!-- Only deploy to ProgramData if explicitly requested AND Revit is not running -->
    <CallTarget Targets="DeployToRevitAddins" Condition="'$(DeployToRevit)' == 'true'" />
  </Target>

  <!-- 
    Separate target for deploying to Revit Addins folder.
    This is called manually via deploy-to-revit.ps1 or when DeployToRevit=true.
  -->
  <Target Name="DeployToRevitAddins">
    <PropertyGroup>
      <RevitAddinFolder>C:\ProgramData\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinFolder>
    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinFolder)" />
    <ItemGroup>
      <LocalApplicationFiles Include="$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.dll" Condition="Exists('$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.dll')" />
      <LocalApplicationFiles Include="$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.pdb" Condition="Exists('$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.pdb')" />
      <LocalSqliteDlls Include="$(LocalDeployFolder)System.Data.SQLite.dll" Condition="Exists('$(LocalDeployFolder)System.Data.SQLite.dll')" />
      <LocalSqliteDlls Include="$(LocalDeployFolder)e_sqlite3.dll" Condition="Exists('$(LocalDeployFolder)e_sqlite3.dll')" />
    </ItemGroup>
    
    <!-- Copy .addin to root addins folder -->
    <Copy SourceFiles="$(LocalDeployFolder)JSE_RevitAddin_MEP_OPENINGS.addin" DestinationFolder="$(RevitAddinFolder)" ContinueOnError="true" />
    
    <!-- Copy DLLs to JSE_MEP_OPENINGS subfolder -->
    <MakeDir Directories="$(RevitAddinFolder)JSE_MEP_OPENINGS\" />
    <Copy SourceFiles="@(LocalApplicationFiles)" DestinationFolder="$(RevitAddinFolder)JSE_MEP_OPENINGS\" ContinueOnError="true" />
    <Copy SourceFiles="@(LocalSqliteDlls)" DestinationFolder="$(RevitAddinFolder)JSE_MEP_OPENINGS\" ContinueOnError="true" />
    
    <!-- Legacy compatibility for x64 subfolder -->
    <MakeDir Directories="$(RevitAddinFolder)JSE_MEP_OPENINGS\x64\" Condition="Exists('$(LocalDeployFolder)x64\SQLite.Interop.dll')" />
    <Copy SourceFiles="$(LocalDeployFolder)x64\SQLite.Interop.dll" DestinationFolder="$(RevitAddinFolder)JSE_MEP_OPENINGS\x64\" ContinueOnError="true" Condition="Exists('$(LocalDeployFolder)x64\SQLite.Interop.dll')" />
    <Message Text="✅ Deployed to Revit $(RevitVersion) Addins folder" Importance="high" />
  </Target>

  <!-- Local API Reference Fallback -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(ProgramFiles)\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\RibbonIcon16.png" />
    <Resource Include="Resources\Icons\RibbonIcon32.png" />
  </ItemGroup>

</Project>
